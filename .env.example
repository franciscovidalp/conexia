# Producción: configure las seis variables de Firebase. La aplicación falla de forma
# segura si se compila sin VITE_FIREBASE_API_KEY.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo desarrollo local. Nunca habilitar en producción.
VITE_ENABLE_DEMO_MODE=false
VITE_DEMO_PASSWORD=
