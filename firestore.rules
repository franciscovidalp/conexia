rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security checks
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return isActiveAccount() ? getUserData().role : 'Suspendido';
    }

    function getRut() {
      return getUserData().rut;
    }

    function getSchool() {
      return getUserData().school;
    }

    function isActiveAccount() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/staff/$(getUserData().staffId)) &&
        (!('active' in get(/databases/$(database)/documents/staff/$(getUserData().staffId)).data) ||
          get(/databases/$(database)/documents/staff/$(getUserData().staffId)).data.active == true);
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'Administrador';
    }

    function belongsToSchool(schoolName) {
      return isActiveAccount() && (isAdmin() || getSchool() == schoolName);
    }

    function isClinicalTeam() {
      return isAuthenticated() && getRole() in ['Administrador', 'Psicólogo', 'Trabajador Social', 'Orientador'];
    }

    // Lets an authenticated account create or repair only its own UID mapping.
    // Every authorization field must exactly match the canonical staff record,
    // so this cannot be used to change role or move an account to another school.
    function isValidSelfUserMapping(userId, data) {
      return isAuthenticated() &&
        request.auth.uid == userId &&
        data.keys().hasOnly(['staffId', 'rut', 'email', 'role', 'school']) &&
        data.staffId is string &&
        exists(/databases/$(database)/documents/staff/$(data.staffId)) &&
        request.auth.token.email == data.email &&
        data.rut == get(/databases/$(database)/documents/staff/$(data.staffId)).data.rut &&
        data.email == get(/databases/$(database)/documents/staff/$(data.staffId)).data.email &&
        data.role == get(/databases/$(database)/documents/staff/$(data.staffId)).data.role &&
        data.school == get(/databases/$(database)/documents/staff/$(data.staffId)).data.school;
    }

    function validRequiredText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function validOptionalText(data, field, maxLength) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLength);
    }

    function validOptionalHttpsUrl(data, field) {
      return !(field in data) || data[field] == null || data[field] == '' ||
        (data[field] is string && data[field].size() <= 1000 && data[field].matches('https://.*'));
    }

    function validPublicSurveyAnswer(answerId) {
      return request.resource.data.keys().hasOnly([
          'id', 'accessToken', 'surveyId', 'studentId', 'studentName', 'grade', 'school',
          'responses', 'score', 'riskStatus', 'submittedAt',
          'privacyNoticeVersion', 'privacyNoticeAcknowledged'
        ]) &&
        request.resource.data.id == answerId &&
        request.resource.data.accessToken == answerId &&
        request.resource.data.accessToken is string &&
        exists(/databases/$(database)/documents/survey_access/$(request.resource.data.accessToken)) &&
        !('revokedAt' in get(/databases/$(database)/documents/survey_access/$(request.resource.data.accessToken)).data) &&
        request.time.toMillis() <
          get(/databases/$(database)/documents/survey_access/$(request.resource.data.accessToken)).data.expiresAt &&
        request.resource.data.surveyId ==
          get(/databases/$(database)/documents/survey_access/$(request.resource.data.accessToken)).data.surveyId &&
        request.resource.data.school ==
          get(/databases/$(database)/documents/survey_access/$(request.resource.data.accessToken)).data.school &&
        request.resource.data.grade ==
          get(/databases/$(database)/documents/survey_access/$(request.resource.data.accessToken)).data.grade &&
        request.resource.data.studentId ==
          get(/databases/$(database)/documents/survey_access/$(request.resource.data.accessToken)).data.respondent.id &&
        request.resource.data.studentName ==
          get(/databases/$(database)/documents/survey_access/$(request.resource.data.accessToken)).data.respondent.firstName + ' ' +
          get(/databases/$(database)/documents/survey_access/$(request.resource.data.accessToken)).data.respondent.lastName &&
        request.resource.data.surveyId in [
          'dia-clima-aula', 'dia-bienestar-autoestima', 'dia-relaciones-bullying',
          'dia-vinculo-familia', 'dia-sociograma', 'convivencia-rice',
          'resolucion-conflictos'
        ] &&
        request.resource.data.studentId is string &&
        request.resource.data.studentName is string &&
        request.resource.data.grade is string &&
        request.resource.data.school is string &&
        request.resource.data.responses is map &&
        request.resource.data.responses.size() <= 12 &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 5 &&
        request.resource.data.riskStatus in ['Bajo', 'Medio', 'Alto', 'Crítico'] &&
        request.resource.data.submittedAt is string &&
        request.resource.data.privacyNoticeVersion == '2026-09-08' &&
        request.resource.data.privacyNoticeAcknowledged == true &&
        exists(/databases/$(database)/documents/students/$(request.resource.data.studentId)) &&
        get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.school == request.resource.data.school &&
        get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.grade == request.resource.data.grade &&
        request.resource.data.studentName ==
          get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.firstName + ' ' +
          get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.lastName;
    }

    // --- COLLECTION RULES ---

    // 1. Schools Collection
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getRole() == 'Administrador';
    }

    // 2. Users Collection (UID mapping document created at login)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isValidSelfUserMapping(userId, request.resource.data) || isAdmin();
      allow delete: if isAdmin();
      allow update: if isValidSelfUserMapping(userId, request.resource.data) || isAdmin();
    }

    // 3. Staff Collection
    match /staff/{staffId} {
      allow read: if isAuthenticated() && (
        request.auth.token.email == resource.data.email ||
        belongsToSchool(resource.data.school)
      );
      allow create: if isAuthenticated() && (getRole() == 'Administrador' || (
        getRole() == 'Directivo' &&
        belongsToSchool(request.resource.data.school) &&
        request.resource.data.school == getSchool() &&
        request.resource.data.role != 'Administrador'
      ));
      allow update: if isAuthenticated() && (
        getRole() == 'Administrador' || 
        (getRole() == 'Directivo' && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
          request.resource.data.get('active', true) == resource.data.get('active', true) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.school == resource.data.school) ||
        (
          request.auth.token.email == resource.data.email && 
          request.auth.token.email == request.resource.data.email &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.school == resource.data.school &&
          request.resource.data.get('active', true) == resource.data.get('active', true)
        )
      );
      allow delete: if false;
    }

    match /login_events/{eventId} {
      allow read: if isAdmin() && belongsToSchool(resource.data.school);
      allow create: if isActiveAccount() &&
        request.resource.data.keys().hasOnly(['id', 'actorUid', 'actorEmail', 'staffId', 'school', 'role', 'occurredAt', 'userAgent', 'recentlyReactivated']) &&
        request.resource.data.id == eventId &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.staffId == getUserData().staffId &&
        request.resource.data.school == getSchool() &&
        request.resource.data.role == getRole() &&
        request.resource.data.userAgent is string &&
        request.resource.data.userAgent.size() <= 200 &&
        request.resource.data.recentlyReactivated is bool &&
        request.resource.data.occurredAt is number &&
        request.resource.data.occurredAt >= request.time.toMillis() - 60000 &&
        request.resource.data.occurredAt <= request.time.toMillis() + 60000;
      allow update: if false;
      allow delete: if isAdmin() && resource.data.occurredAt < request.time.toMillis() - 31536000000;
    }

    // 4. Students Collection
    match /students/{studentId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) && 
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) && 
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) && 
        getRole() == 'Administrador';
    }

    // 5. Coexistence Cases Collection
    match /coexistence_cases/{caseId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Docente'];
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) &&
        validRequiredText(request.resource.data.description, 4000) &&
        validOptionalText(request.resource.data, 'actionPlan', 4000) &&
        validOptionalText(request.resource.data, 'commitments', 4000) &&
        validOptionalHttpsUrl(request.resource.data, 'evidenceUrl');
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
        getRole() in ['Administrador', 'Directivo', 'Convivencia'] &&
        validRequiredText(request.resource.data.description, 4000) &&
        validOptionalText(request.resource.data, 'actionPlan', 4000) &&
        validOptionalText(request.resource.data, 'commitments', 4000) &&
        validOptionalHttpsUrl(request.resource.data, 'evidenceUrl');
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) && getRole() == 'Administrador';
    }

    // 6. Prevention/Contention Activities
    match /activities/{activityId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Docente'];
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) && getRole() in ['Administrador', 'Directivo', 'Convivencia'] &&
        validRequiredText(request.resource.data.title, 200) && validRequiredText(request.resource.data.speaker, 200) &&
        validRequiredText(request.resource.data.location, 300) && validOptionalText(request.resource.data, 'summary', 4000) &&
        validOptionalHttpsUrl(request.resource.data, 'evidenceUrl');
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) && getRole() in ['Administrador', 'Directivo', 'Convivencia'] &&
        validRequiredText(request.resource.data.title, 200) && validRequiredText(request.resource.data.speaker, 200) &&
        validRequiredText(request.resource.data.location, 300) && validOptionalText(request.resource.data, 'summary', 4000) &&
        validOptionalHttpsUrl(request.resource.data, 'evidenceUrl');
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) && getRole() == 'Administrador';
    }

    // 7. Psychosocial Cases (Sensitive Clinical Data)
    match /psychosocial_cases/{caseId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        isClinicalTeam();
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']) &&
        validRequiredText(request.resource.data.reason, 4000);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
        isClinicalTeam() && validRequiredText(request.resource.data.reason, 4000);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        isClinicalTeam();
    }

    // 8. Clinical Sessions (Highly Sensitive Medical/Therapeutic Notes)
    match /clinical_sessions/{sessionId} {
      allow read: if isAuthenticated() &&
        belongsToSchool(get(/databases/$(database)/documents/psychosocial_cases/$(resource.data.caseId)).data.school) &&
        isClinicalTeam();
      allow create: if isAuthenticated() && 
        belongsToSchool(get(/databases/$(database)/documents/psychosocial_cases/$(request.resource.data.caseId)).data.school) &&
        isClinicalTeam() && validRequiredText(request.resource.data.notes, 8000) &&
        validOptionalText(request.resource.data, 'agreements', 4000);
      allow update: if isAuthenticated() && 
        belongsToSchool(get(/databases/$(database)/documents/psychosocial_cases/$(resource.data.caseId)).data.school) &&
        belongsToSchool(get(/databases/$(database)/documents/psychosocial_cases/$(request.resource.data.caseId)).data.school) &&
        isClinicalTeam() && validRequiredText(request.resource.data.notes, 8000) &&
        validOptionalText(request.resource.data, 'agreements', 4000);
      allow delete: if isAuthenticated() && 
        belongsToSchool(get(/databases/$(database)/documents/psychosocial_cases/$(resource.data.caseId)).data.school) &&
        isClinicalTeam();
    }

    // 9. Messages (Chat)
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        getRut() == resource.data.senderId ||
        getRut() == resource.data.recipientId
      );
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'id', 'senderId', 'senderName', 'recipientId', 'recipientName',
          'school', 'message', 'createdAt'
        ]) &&
        request.resource.data.senderId == getRut() &&
        (isAdmin() || request.resource.data.school == getSchool()) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 4000;
      allow update, delete: if false; // Messages are immutable
    }

    // 10. Meetings
    match /meetings/{meetingId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Docente', 'Psicólogo', 'Trabajador Social'];
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']) &&
        validRequiredText(request.resource.data.title, 200) && validOptionalText(request.resource.data, 'description', 4000);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']) &&
        validRequiredText(request.resource.data.title, 200) && validOptionalText(request.resource.data, 'description', 4000);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) && getRole() == 'Administrador';
    }

    // 11. Survey Answers
    match /survey_answers/{answerId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
      allow create: if (
        isAdmin() &&
        belongsToSchool(request.resource.data.school)
      ) || validPublicSurveyAnswer(answerId);
      allow update: if false;
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) && getRole() == 'Administrador';
    }

    // Capability links: public access is limited to an unguessable document id.
    // Listing is forbidden and links expire automatically after seven days.
    match /survey_access/{token} {
      allow get: if resource.data.respondent is map &&
        !('revokedAt' in resource.data) &&
        resource.data.expiresAt is number &&
        request.time.toMillis() < resource.data.expiresAt;
      allow list: if isAdmin();
      allow create: if isAuthenticated() &&
        belongsToSchool(request.resource.data.school) &&
        getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador'] &&
        request.resource.data.id == token &&
        request.resource.data.expiresAt is number &&
        request.resource.data.expiresAt > request.time.toMillis() &&
        request.resource.data.expiresAt <= request.time.toMillis() + 604800000 &&
        request.resource.data.keys().hasOnly([
          'id', 'surveyId', 'school', 'grade', 'expiresAt', 'createdBy', 'respondent', 'participants'
        ]) &&
        request.resource.data.respondent is map &&
        request.resource.data.respondent.keys().hasOnly(['id', 'firstName', 'lastName']) &&
        request.resource.data.respondent.id is string &&
        request.resource.data.respondent.firstName is string &&
        request.resource.data.respondent.lastName is string &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() <= 100;
      allow update: if isAdmin() && belongsToSchool(resource.data.school) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt', 'revokedBy']);
      allow delete: if isAdmin() || (
        isAuthenticated() && belongsToSchool(resource.data.school)
      );
    }

    // Immutable security audit trail. Clients may append their own actions but
    // cannot alter or erase history; only administrators may review it.
    match /audit_logs/{eventId} {
      allow read: if isAdmin() && belongsToSchool(resource.data.school);
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'id', 'actorUid', 'actorEmail', 'action', 'school', 'resourceType', 'metadata', 'occurredAt'
        ]) &&
        request.resource.data.id == eventId &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email &&
        belongsToSchool(request.resource.data.school) &&
        request.resource.data.action is string &&
        request.resource.data.resourceType is string &&
        request.resource.data.metadata is map &&
        request.resource.data.occurredAt is number &&
        request.resource.data.occurredAt >= request.time.toMillis() - 60000 &&
        request.resource.data.occurredAt <= request.time.toMillis() + 60000;
      allow update, delete: if false;
    }

    match /privacy_settings/{schoolId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && belongsToSchool(request.resource.data.school) &&
        request.resource.data.school == schoolId &&
        request.resource.data.surveyRetentionDays is int &&
        request.resource.data.surveyRetentionDays >= 30 &&
        request.resource.data.surveyRetentionDays <= 1825;
      allow delete: if false;
    }

    match /security_incidents/{incidentId} {
      allow read: if isAdmin() && belongsToSchool(resource.data.school);
      allow create: if isAdmin() && belongsToSchool(request.resource.data.school) &&
        request.resource.data.id == incidentId;
      allow update: if isAdmin() && belongsToSchool(resource.data.school) &&
        request.resource.data.school == resource.data.school &&
        request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    // 12. Rice Protocols
    match /rice_protocols/{protocolId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        getRole() in ['Administrador', 'Directivo', 'Convivencia'];
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']) &&
        request.resource.data.steps is list && request.resource.data.steps.size() <= 20 &&
        (!('measures' in request.resource.data) || (request.resource.data.measures is list && request.resource.data.measures.size() <= 30));
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']) &&
        request.resource.data.steps is list && request.resource.data.steps.size() <= 20 &&
        (!('measures' in request.resource.data) || (request.resource.data.measures is list && request.resource.data.measures.size() <= 30));
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) && getRole() == 'Administrador';
    }

    // 13. Management Objectives (Plan de Gestión)
    match /objectives/{objectiveId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        getRole() in ['Administrador', 'Directivo', 'Convivencia'];
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']) &&
        validRequiredText(request.resource.data.title, 200) && validRequiredText(request.resource.data.description, 4000) &&
        validRequiredText(request.resource.data.target, 500);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']) &&
        validRequiredText(request.resource.data.title, 200) && validRequiredText(request.resource.data.description, 4000) &&
        validRequiredText(request.resource.data.target, 500);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) && getRole() == 'Administrador';
    }

    // 14. External Referrals (Derivaciones)
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']) &&
        validRequiredText(request.resource.data.reason, 4000) && validRequiredText(request.resource.data.previousMeasures, 4000) &&
        validOptionalText(request.resource.data, 'observations', 4000);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']) &&
        validRequiredText(request.resource.data.reason, 4000) && validRequiredText(request.resource.data.previousMeasures, 4000) &&
        validOptionalText(request.resource.data, 'observations', 4000);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) && getRole() == 'Administrador';
    }

    // 15. Parent Summons (Citaciones)
    match /parent_summons/{summonsId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        getRole() in ['Administrador', 'Directivo', 'Convivencia'];
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']) &&
        validRequiredText(request.resource.data.reason, 4000) && validOptionalText(request.resource.data, 'notes', 4000) &&
        validRequiredText(request.resource.data.location, 300);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']) &&
        validRequiredText(request.resource.data.reason, 4000) && validOptionalText(request.resource.data, 'notes', 4000) &&
        validRequiredText(request.resource.data.location, 300);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) && getRole() == 'Administrador';
    }
  }
}
