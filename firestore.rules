rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security checks
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return getUserData().role;
    }

    function getRut() {
      return getUserData().rut;
    }

    function getSchool() {
      return getUserData().school;
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'Administrador';
    }

    function belongsToSchool(schoolName) {
      return isAuthenticated() && (isAdmin() || getSchool() == schoolName);
    }

    function isClinicalTeam() {
      return getRole() in ['Administrador', 'Psicólogo', 'Trabajador Social', 'Orientador'];
    }

    function validPublicSurveyAnswer(answerId) {
      return request.resource.data.keys().hasOnly([
          'id', 'accessToken', 'surveyId', 'studentId', 'studentName', 'grade', 'school',
          'responses', 'score', 'riskStatus', 'submittedAt'
        ]) &&
        request.resource.data.id == answerId &&
        request.resource.data.accessToken is string &&
        exists(/databases/$(database)/documents/survey_access/$(request.resource.data.accessToken)) &&
        request.time.toMillis() <
          get(/databases/$(database)/documents/survey_access/$(request.resource.data.accessToken)).data.expiresAt &&
        request.resource.data.surveyId ==
          get(/databases/$(database)/documents/survey_access/$(request.resource.data.accessToken)).data.surveyId &&
        request.resource.data.school ==
          get(/databases/$(database)/documents/survey_access/$(request.resource.data.accessToken)).data.school &&
        request.resource.data.grade ==
          get(/databases/$(database)/documents/survey_access/$(request.resource.data.accessToken)).data.grade &&
        request.resource.data.surveyId in [
          'dia-clima-aula', 'dia-bienestar-autoestima', 'dia-relaciones-bullying',
          'dia-vinculo-familia', 'dia-sociograma', 'convivencia-rice',
          'resolucion-conflictos'
        ] &&
        request.resource.data.studentId is string &&
        request.resource.data.studentName is string &&
        request.resource.data.grade is string &&
        request.resource.data.school is string &&
        request.resource.data.responses is map &&
        request.resource.data.responses.size() <= 12 &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 5 &&
        request.resource.data.riskStatus in ['Bajo', 'Medio', 'Alto', 'Crítico'] &&
        request.resource.data.submittedAt is string &&
        exists(/databases/$(database)/documents/students/$(request.resource.data.studentId)) &&
        get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.school == request.resource.data.school &&
        get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.grade == request.resource.data.grade &&
        request.resource.data.studentName ==
          get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.firstName + ' ' +
          get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.lastName;
    }

    // --- COLLECTION RULES ---

    // 1. Schools Collection
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getRole() == 'Administrador';
    }

    // 2. Users Collection (UID mapping document created at login)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        request.auth.token.email == request.resource.data.email &&
        request.resource.data.staffId is string &&
        request.resource.data.rut ==
          get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.rut &&
        request.resource.data.email ==
          get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.email &&
        request.resource.data.role ==
          get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.role &&
        request.resource.data.school ==
          get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.school
      );
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([])
      );
    }

    // 3. Staff Collection
    match /staff/{staffId} {
      allow read: if isAuthenticated() && (
        request.auth.token.email == resource.data.email ||
        belongsToSchool(resource.data.school)
      );
      allow create: if isAuthenticated() && (getRole() == 'Administrador' || (getRole() == 'Directivo' && belongsToSchool(request.resource.data.school)));
      allow update: if isAuthenticated() && (
        getRole() == 'Administrador' || 
        (getRole() == 'Directivo' && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school)) ||
        (
          request.auth.token.email == resource.data.email && 
          request.auth.token.email == request.resource.data.email &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.school == resource.data.school
        )
      );
      allow delete: if isAuthenticated() && (getRole() == 'Administrador' || (getRole() == 'Directivo' && belongsToSchool(resource.data.school)));
    }

    // 4. Students Collection
    match /students/{studentId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) && 
        (getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) && 
        (getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) && 
        (getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']);
    }

    // 5. Coexistence Cases Collection
    match /coexistence_cases/{caseId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school);
    }

    // 6. Prevention/Contention Activities
    match /activities/{activityId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school);
    }

    // 7. Psychosocial Cases (Sensitive Clinical Data)
    match /psychosocial_cases/{caseId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']);
    }

    // 8. Clinical Sessions (Highly Sensitive Medical/Therapeutic Notes)
    match /clinical_sessions/{sessionId} {
      allow read: if isAuthenticated() &&
        belongsToSchool(get(/databases/$(database)/documents/psychosocial_cases/$(resource.data.caseId)).data.school) &&
        isClinicalTeam();
      allow create: if isAuthenticated() && 
        belongsToSchool(get(/databases/$(database)/documents/psychosocial_cases/$(request.resource.data.caseId)).data.school) &&
        isClinicalTeam();
      allow update: if isAuthenticated() && 
        belongsToSchool(get(/databases/$(database)/documents/psychosocial_cases/$(resource.data.caseId)).data.school) &&
        belongsToSchool(get(/databases/$(database)/documents/psychosocial_cases/$(request.resource.data.caseId)).data.school) &&
        isClinicalTeam();
      allow delete: if isAuthenticated() && 
        belongsToSchool(get(/databases/$(database)/documents/psychosocial_cases/$(resource.data.caseId)).data.school) &&
        isClinicalTeam();
    }

    // 9. Messages (Chat)
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        getRut() == resource.data.senderId ||
        getRut() == resource.data.recipientId
      );
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'id', 'senderId', 'senderName', 'recipientId', 'recipientName',
          'school', 'message', 'createdAt'
        ]) &&
        request.resource.data.senderId == getRut() &&
        request.resource.data.school == getSchool() &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 4000;
      allow update, delete: if false; // Messages are immutable
    }

    // 10. Meetings
    match /meetings/{meetingId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
    }

    // 11. Survey Answers
    match /survey_answers/{answerId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
      allow create: if validPublicSurveyAnswer(answerId);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
    }

    // Capability links: public access is limited to an unguessable document id.
    // Listing is forbidden and links expire automatically after seven days.
    match /survey_access/{token} {
      allow get: if resource.data.expiresAt is number &&
        request.time.toMillis() < resource.data.expiresAt;
      allow list: if isAdmin();
      allow create: if isAuthenticated() &&
        belongsToSchool(request.resource.data.school) &&
        getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador'] &&
        request.resource.data.id == token &&
        request.resource.data.expiresAt is number &&
        request.resource.data.expiresAt > request.time.toMillis() &&
        request.resource.data.expiresAt <= request.time.toMillis() + 604800000 &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() <= 100;
      allow update: if false;
      allow delete: if isAdmin() || (
        isAuthenticated() && belongsToSchool(resource.data.school)
      );
    }

    // 12. Rice Protocols
    match /rice_protocols/{protocolId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
    }

    // 13. Management Objectives (Plan de Gestión)
    match /objectives/{objectiveId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
    }

    // 14. External Referrals (Derivaciones)
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia', 'Orientador', 'Psicólogo', 'Trabajador Social']);
    }

    // 15. Parent Summons (Citaciones)
    match /parent_summons/{summonsId} {
      allow read: if isAuthenticated() && belongsToSchool(resource.data.school);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
      allow update: if isAuthenticated() && belongsToSchool(resource.data.school) && belongsToSchool(request.resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
      allow delete: if isAuthenticated() && belongsToSchool(resource.data.school) &&
        (getRole() in ['Administrador', 'Directivo', 'Convivencia']);
    }
  }
}
